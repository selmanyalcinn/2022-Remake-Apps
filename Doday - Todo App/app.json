{
  "expo": {
    "name": "Tudu",
    "slug": "tudu",
    "owner": "yalcinse26",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/tudu-icon.png",
    "scheme": "tudu",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.doday.app",
      "icon": "./assets/images/tudu-icon.png",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FBDB04",
        "foregroundImage": "./assets/images/tudu-adaptive-foreground.png",
        "monochromeImage": "./assets/images/tudu-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/tudu-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/tudu-splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FBDB04",
          "dark": {
            "backgroundColor": "#FBDB04"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-screen-orientation",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e20a09a9-7af2-4480-9887-1235404b966a"
      }
    }
  }
}
